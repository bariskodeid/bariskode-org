# ============================================================
# Bariskode Platform — Environment Variables
# Copy this to .env and fill in the values
# ============================================================

# PocketBase
PUBLIC_POCKETBASE_URL=http://localhost:8090
PUBLIC_SITE_URL=http://localhost:4321
# Trust x-forwarded-for / x-real-ip headers for rate limiting keying.
# Set to true only when running behind a trusted proxy that overwrites these headers.
TRUST_PROXY_HEADERS=false

# Rate limiting backend
# - memory (default, local/dev)
# - upstash (distributed, recommended for multi-instance production)
RATE_LIMIT_BACKEND=memory
# Timeout/retry for distributed limiter backend (milliseconds / retry count)
RATE_LIMIT_BACKEND_TIMEOUT_MS=1500
RATE_LIMIT_BACKEND_MAX_RETRIES=1
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Edge/body limit reminder:
# Keep strict request body limits at ingress/CDN (primary protection),
# while app-level checks act as defense-in-depth.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Trusted app-admin users (PocketBase user record IDs, comma-separated).
# Required for /admin access. A mutable PocketBase role alone is not sufficient.
ADMIN_USER_IDS=

# Judge0 Code Execution (Phase 2)
JUDGE0_URL=http://localhost:2358

# Meilisearch (Phase 3)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=

# OAuth — configure in PocketBase Admin UI (Settings → Auth Providers)
# PB_GITHUB_CLIENT_ID=
# PB_GITHUB_CLIENT_SECRET=
# PB_GOOGLE_CLIENT_ID=
# PB_GOOGLE_CLIENT_SECRET=

# Cloudflare R2 Storage (Phase 2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=bariskode-assets
